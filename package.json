{
  "name": "@micro-battles/monorepo",
  "version": "1.0.0",
  "workspaces": {
    "packages": [
      "services/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "5.1.6",
      "elysia": "1.3.13",
      "@types/node": "20.8.10",
      "@types/bun": "1.2.20"
    }
  },
  "scripts": {
    "install:services": "bun install --filter ./services/*",
    "install:packages": "bun install --filter ./packages/*",
    "dev:auth-service": "bun --watch run ./services/auth/src/server.ts"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
